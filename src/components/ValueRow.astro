---
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  heading: string;
  /** Body copy; contains inline <strong> emphasis from the design. */
  body: string;
  hint: string;
  /** Tailwind background class for the image fill. */
  fill: string;
  /** Image on the left on desktop — the zig-zag row. */
  reversed?: boolean;
}

const { heading, body, hint, fill, reversed = false } = Astro.props;
---

{/*
  The image is always first in the DOM so every row stacks image-then-text once the
  grid collapses to one column. The desktop zig-zag is done with `order` instead of
  DOM order, and the columns and the order flip at the same breakpoint.
*/}
<div class="grid grid-cols-1 items-center gap-[clamp(28px,4vw,64px)] md:grid-cols-2">
  <div class:list={['relative aspect-4/3 w-full', fill, !reversed && 'md:order-2']}>
    <ImagePlaceholder hint={hint} />
  </div>

  <div class:list={['flex flex-col gap-4', !reversed && 'md:order-1']}>
    <h3
      class="m-0 font-display text-[clamp(20px,1.85vw,26px)] leading-[1.26] font-normal text-pretty"
    >
      {heading}
    </h3>
    <p
      class="m-0 max-w-[46ch] text-[clamp(15px,1.1vw,17px)] leading-[1.6] tracking-[0.16px] text-pretty"
      set:html={body}
    />
  </div>
</div>
