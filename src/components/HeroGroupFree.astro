---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.png';

/*
  Submits straight to the public action of a saved Sequenzy form (id
  i2zovcewi1j441g95bqmtpol, company "Lili Meseműhelye", list "2026/10/07").
  That action URL is a client-safe capability — the list, tags and success
  behavior are fixed server-side, so no API key belongs here.
*/
const SEQUENZY_FORM_ACTION_URL =
  'https://api.sequenzy.com/api/v1/forms/i2zovcewi1j441g95bqmtpol';
const SUCCESS_URL = 'https://lilimesemuhelye.hu/sikeres-csoportos-foglalas';

const legalLinkClass =
  'text-slate underline underline-offset-2 hover:text-terracotta';

// The legal pages open in a new tab so an in-progress signup is not lost.
const legalLinkAttrs = { target: '_blank', rel: 'noopener' };

const assurances = [
  '100% Online & Ingyenes',
  'Semmilyen kötelezettséggel nem jár',
  'Nincs kártyaadat megadás',
];
---

{/* Desktop carries no vertical padding and no minimum height: the form card is the
    tallest thing there, so it sets the section's height and its top and bottom edges
    ARE the section's edges. Anything that forces the section taller reappears as dead
    space above the content.

    Mobile stacks copy-then-form, so a top inset sits above the copy rather than
    above nothing — it reads as breathing room under the header, not as a gap. */}
<section
  class="flex items-stretch bg-cream px-[4vw] pt-[clamp(32px,9vw,56px)] pb-[clamp(32px,9vw,56px)] font-body font-light text-slate md:pb-0"
  aria-label="Bemutatkozás"
>
  <div
    class="mx-auto grid w-full max-w-canvas items-center gap-[clamp(28px,4vw,72px)] md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]"
  >
    {/* Centred while stacked, left-aligned once the two columns appear. */}
    <div
      class="mx-auto flex max-w-[700px] flex-col items-center gap-[clamp(14px,2.2vh,24px)] text-center md:mx-0 md:items-start md:text-left"
    >
      <div
        class="flex items-center gap-2 rounded-pill bg-apricot/25 px-[16px] py-[8px] text-[13px] font-semibold tracking-[0.16px]"
      >
        <span class="flex gap-[2px] text-terracotta" aria-hidden="true">
          {
            Array.from({ length: 5 }).map(() => (
              <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 1.5 12.6 7.3 19 8 14.2 12.2 15.5 18.5 10 15.2 4.5 18.5 5.8 12.2 1 8 7.4 7.3Z" />
              </svg>
            ))
          }
        </span>
        <span>A résztvevők 100%-a ajánlja</span>
      </div>

      <h1
        class="m-0 font-display text-[clamp(22px,2.05vw,32px)] leading-[1.18] font-normal tracking-[-0.01em] text-pretty"
      >
        Őszi Stessz &amp; Túlterheltség: Ingyenes online mesefoglalkozás felnőtt
        nőknek
      </h1>

      <div
        class="flex flex-wrap items-center gap-x-[22px] gap-y-[10px] text-[15px] font-semibold text-terracotta"
      >
        <div class="flex items-center gap-[9px]">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="flex-none"
          >
            <rect x="3" y="4.5" width="18" height="16" rx="2" />
            <path d="M16 2.5v4M8 2.5v4M3 9.5h18" />
          </svg>
          <span>2026. Október 07. 10:00</span>
        </div>

        <div class="flex items-center gap-[9px]">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="flex-none"
          >
            <path
              d="M22.5 6.42a2.78 2.78 0 0 0-1.96-1.97C18.88 4 12 4 12 4s-6.88 0-8.54.45A2.78 2.78 0 0 0 1.5 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .5 5.58 2.78 2.78 0 0 0 1.96 1.97C5.12 20 12 20 12 20s6.88 0 8.54-.45a2.78 2.78 0 0 0 1.96-1.97A29 29 0 0 0 23 12a29 29 0 0 0-.5-5.58ZM9.75 15.5v-7L15.5 12Z"
            />
          </svg>
          <span>YouTube</span>
        </div>
      </div>
    </div>

    {/* Right column: the original hero photo on top, the signup form — the page's
        one and only CTA, no popup needed — stacked below it. */}
    <div class="flex flex-col gap-[clamp(24px,3vw,36px)]">
      <div class="relative aspect-4/5 w-4/5 justify-self-center md:justify-self-end">
        {/* Above the fold: eager + high priority so it is not discovered late. */}
        <Image
          src={heroImage}
          alt="Lili, a Lili Meseműhelye alapítója"
          widths={[480, 720, 1080]}
          sizes="(max-width: 768px) 74vw, 36vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>

      <div
        id="jelentkezes"
        class="scroll-mt-[96px] w-full max-w-[440px] justify-self-center overflow-hidden rounded-[24px] border border-hairline-soft bg-cream shadow-[0_20px_45px_-15px_rgba(80,86,94,0.35)] md:justify-self-end"
      >
        <form
          id="signup-form"
          class="flex flex-col gap-[14px] p-[clamp(20px,2.6vw,30px)]"
          novalidate
        >
        <label class="flex flex-col gap-[6px]">
          <span class="text-[14px] font-semibold">Keresztnév</span>
          <input
            type="text"
            name="firstName"
            autocomplete="given-name"
            required
            class="border border-hairline bg-cream px-[14px] py-[11px] text-[15px] text-slate outline-none focus:border-terracotta"
          />
        </label>

        <label class="flex flex-col gap-[6px]">
          <span class="text-[14px] font-semibold">Email cím</span>
          <input
            type="email"
            name="email"
            autocomplete="email"
            required
            class="border border-hairline bg-cream px-[14px] py-[11px] text-[15px] text-slate outline-none focus:border-terracotta"
          />
        </label>

        <label class="flex items-start gap-[10px]">
          <input
            type="checkbox"
            name="customAttributes[consent]"
            value="true"
            required
            class="mt-[3px] h-[16px] w-[16px] flex-none accent-terracotta"
          />
          <span class="text-[13px] leading-[1.55] opacity-85 text-pretty">
            Elolvastam, megértettem és elfogadom az
            <a href="/aszf" class={legalLinkClass} {...legalLinkAttrs}
              >Általános Szerződési Feltételeket</a
            >, az
            <a href="/adatvedelem" class={legalLinkClass} {...legalLinkAttrs}
              >Adatvédelmi Tájékoztatót</a
            >, valamint a
            <a href="/nyilatkozat" class={legalLinkClass} {...legalLinkAttrs}
              >Felelősségkizáró és Egészségügyi Nyilatkozatot</a
            >, és a bennük foglaltakat magamra nézve kötelező érvényűnek ismerem el.
          </span>
        </label>

        {/* Honeypot: hidden from real visitors, so a filled-in value flags a bot. */}
        <div aria-hidden="true" class="absolute -left-[9999px]">
          <label>
            Leave this field blank
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <p id="signup-form-error" class="m-0 hidden text-[13px] text-terracotta" role="alert">
          Hiba történt a jelentkezés elküldésekor. Kérlek, próbáld újra.
        </p>

        <button
          type="submit"
          class="btn-apricot mt-[4px] cursor-pointer px-[30px] py-[15px] text-[clamp(15px,1.1vw,17px)] font-semibold disabled:cursor-not-allowed disabled:opacity-60"
        >
          Szeretném kipróbálni a mesék ősi hatását díjmentesen
        </button>

        <ul
          class="m-0 flex list-none flex-wrap justify-center gap-x-[18px] gap-y-[8px] p-0 text-[13px] leading-[1.4] tracking-[0.16px] opacity-85"
        >
          {
            assurances.map((item) => (
              <li class="flex items-center gap-[8px]">
                <span class="block h-[5px] w-[5px] rounded-full bg-sage" />
                {item}
              </li>
            ))
          }
        </ul>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ formActionUrl: SEQUENZY_FORM_ACTION_URL, successUrl: SUCCESS_URL }}>
  const form = document.getElementById('signup-form');
  const errorMessage = document.getElementById('signup-form-error');

  if (form instanceof HTMLFormElement) {
    const submitButton = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      errorMessage?.classList.add('hidden');
      submitButton?.setAttribute('disabled', '');

      try {
        const response = await fetch(formActionUrl, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
          redirect: 'manual',
        });

        // A successful Sequenzy submission redirects to the form's configured
        // redirectUrl; the browser reports that as an opaque redirect here.
        const succeeded =
          response.type === 'opaqueredirect' ||
          (response.status >= 300 && response.status < 400) ||
          response.ok;

        if (!succeeded) throw new Error('submission failed');

        form.reset();
        window.location.assign(successUrl);
      } catch {
        errorMessage?.classList.remove('hidden');
      } finally {
        submitButton?.removeAttribute('disabled');
      }
    });
  }
</script>
