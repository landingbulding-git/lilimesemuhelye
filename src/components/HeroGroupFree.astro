---
import { Image } from 'astro:assets';
import signupCover from '../assets/signup-cover.webp';

const assurances = [
  '100% Online & Ingyenes',
  'Semmilyen kötelezettséggel nem jár',
  'Nincs kártyaadat megadás',
];
---

<section
  class="bg-cream px-[4vw] py-[clamp(32px,9vw,56px)] font-body font-light text-slate"
  aria-label="Bemutatkozás"
>
  <div
    class="mx-auto grid w-full max-w-canvas items-center gap-[clamp(28px,4vw,56px)] md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]"
  >
    <div
      class="mx-auto flex max-w-[700px] flex-col items-center gap-[clamp(14px,2.2vh,24px)] text-center md:mx-0 md:items-start md:text-left"
    >
      <div
        class="flex items-center gap-2 rounded-pill bg-apricot/25 px-[16px] py-[8px] text-[13px] font-semibold tracking-[0.16px]"
      >
        <span class="flex gap-[2px] text-terracotta" aria-hidden="true">
          {
            Array.from({ length: 5 }).map(() => (
              <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 1.5 12.6 7.3 19 8 14.2 12.2 15.5 18.5 10 15.2 4.5 18.5 5.8 12.2 1 8 7.4 7.3Z" />
              </svg>
            ))
          }
        </span>
        <span>A résztvevők 100%-a ajánlja</span>
      </div>

      <h1
        class="m-0 font-display text-[clamp(22px,2.05vw,32px)] leading-[1.18] font-normal tracking-[-0.01em] text-pretty"
      >
        Őszi Stessz &amp; Túlterheltség: Ingyenes online mesefoglalkozás felnőtt
        nőknek
      </h1>

      <div
        class="flex flex-wrap items-center justify-center gap-x-[22px] gap-y-[10px] text-[15px] font-semibold text-terracotta md:justify-start"
      >
        <div class="flex items-center gap-[9px]">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="flex-none"
          >
            <rect x="3" y="4.5" width="18" height="16" rx="2" />
            <path d="M16 2.5v4M8 2.5v4M3 9.5h18" />
          </svg>
          <span>2026. Október 21. 10:00</span>
        </div>

        <div class="flex items-center gap-[9px]">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="flex-none"
          >
            <path
              d="M22.5 6.42a2.78 2.78 0 0 0-1.96-1.97C18.88 4 12 4 12 4s-6.88 0-8.54.45A2.78 2.78 0 0 0 1.5 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .5 5.58 2.78 2.78 0 0 0 1.96 1.97C5.12 20 12 20 12 20s6.88 0 8.54-.45a2.78 2.78 0 0 0 1.96-1.97A29 29 0 0 0 23 12a29 29 0 0 0-.5-5.58ZM9.75 15.5v-7L15.5 12Z"
            />
          </svg>
          <span>YouTube</span>
        </div>
      </div>

      <div class="flex flex-col items-center gap-[14px] md:items-start">
        <a
          href="https://luma.com/event/evt-QCOFb7AANayilvW"
          class="btn-apricot px-[30px] py-[15px] text-[clamp(15px,1.1vw,17px)] font-semibold"
          data-luma-action="checkout"
          data-luma-event-id="evt-QCOFb7AANayilvW"
        >
          Kipróbálom a mesék ősi hatását
        </a>

        <ul
          class="m-0 flex list-none flex-wrap justify-center gap-x-[18px] gap-y-[8px] p-0 text-[13px] leading-[1.4] tracking-[0.16px] opacity-85 md:justify-start"
        >
          {
            assurances.map((item) => (
              <li class="flex items-center gap-[8px]">
                <span class="block h-[5px] w-[5px] rounded-full bg-sage" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[320px] overflow-hidden rounded-[20px] shadow-[0_20px_45px_-15px_rgba(80,86,94,0.35)] md:max-w-none">
      <Image
        src={signupCover}
        alt="Őszi Stessz & Túlterheltség — ingyenes online mesefoglalkozás felnőtt nőknek"
        widths={[320, 480, 640]}
        sizes="(max-width: 767px) 320px, 45vw"
        loading="eager"
        decoding="async"
        class="aspect-[4/3] h-full w-full object-cover object-top"
      />
    </div>
  </div>
</section>

<script id="luma-checkout" src="https://embed.lu.ma/checkout-button.js" is:inline></script>
