---
/*
  "Wall of love" — two video testimonials plus a masonry wall of short text
  reviews underneath, all in one section.

  Video files and their poster frames live in the same Vercel Blob store as
  the text-testimonial avatars below.

  Both video testimonials and the text testimonials underneath are real,
  Typeform-collected feedback from actual group session participants.
*/
const videoTestimonials = [
  {
    name: 'Ági',
    quote:
      'Olyan dolgokat hozott fel, amire egyáltalán nem gondoltam volna, hogy följöhet... Szerintem még napokig fog hullámozni bennem ez az érzés, lesznek még felismeréseim...',
    videoSrc:
      'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/socialproof/agi_compressed.mp4',
    poster:
      'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/socialproof/agi_compressed_poster.jpg',
  },
  {
    name: 'Marianna',
    quote:
      'Abszolút sikerült letenni a megfelelést, teljesen biztonságban éreztem magam... Azoknak ajánlanám, akik szeretnének mondjuk más szemszögből ránézni az adott problémáikra, amivel szembesülnek..',
    videoSrc:
      'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/socialproof/marianna_compressed.mp4',
    poster:
      'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/socialproof/marianna_compressed_poster.jpg',
  },
];

const avatarFills = ['bg-apricot', 'bg-sage', 'bg-terracotta/70'] as const;

// Named "<Firstname>.webp" per participant. Zsaklin has none yet, so her
// card falls back to the initials badge below. Liliána, Ági and Anikó's
// files were saved with a decomposed (NFD) accent — a combining U+0301
// after the base letter — instead of the usual single precomposed
// character, so those three are spelled out as full URLs below rather
// than templated off AVATAR_BASE_URL.
const AVATAR_BASE_URL =
  'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/socialproof';

const textTestimonials = [
  {
    name: 'Afro',
    avatar: `${AVATAR_BASE_URL}/Afro.webp`,
    quote:
      '„Köszönöm szépen a lehetőséget, hogy részt vehettem ezen a foglalkozáson. Az én legnagyobb félelmem az az volt, hogy vajon meg tudok-e nyílni, viszont nagyon könnyen megnyíltam neked. Nagyon alkalmasnak tartalak téged erre a meseterápiára. Lenyűgözött a lelkesedésed is, illetve a szakmai tudásod. Tudtad tartani a biztonságos teret, egyáltalán nem éreztem, hogy ítélkeztél volna rajtam. És ez számomra egy nagyon-nagyon pozitív dolog volt.”',
  },
  {
    name: 'Liliána',
    avatar:
      'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/socialproof/lilia%CC%81na.webp',
    quote:
      '„Nagyon tetszett a közös mesélés, valamint az, hogy utána meditáltunk. Úgy érzem, hogy a mesének nagyon sok mondanivalója van, és nagyon sok szimbóluma is van. A rajzolás kifejezetten tetszett, segített az érzéseimet, a gondolataimat egy kicsit rendezni azáltal, hogy rajzolhattam. A legnagyobb felismerés az volt, hogy önmagam számára is sok tapasztalatot és újdonságot tapasztalhattam meg, viszont az nagyon tetszett, hogy a többiek szemszögét is meghallgathattam. Igazából szerintem minden embernek szüksége lenne rá.”',
  },
  {
    name: 'Edina',
    avatar: `${AVATAR_BASE_URL}/Edina.webp`,
    quote:
      '„Azon gondolkodtam, hogy ez használni fog-e nekem, milyen hatással lesz rám, de aztán úgy döntöttem, hogy végül is veszítenivalóm nincs, és ez egy új dolog, még akár jól is elsülhet. Jól éreztem magam az együtt töltött idő alatt. Kortól, nemtől, beállítottságtól, nézetektől függetlenül bárkinek szívesen ajánlom ezt a foglalkozást, akinek van kedve és lehetősége két órán át kikapcsolódni teljesen, és csak magával foglalkozni.”',
  },
  {
    name: 'Marianna',
    avatar: `${AVATAR_BASE_URL}/Marianna.webp`,
    quote:
      '„Abszolút sikerült letenni a megfelelést, teljesen biztonságban éreztem magam. Nagyon türelmes, nyitott és kedves voltál, egyáltalán nem éreztem sürgetve magam, vagy azt, hogy bármire bárhogy kell viselkednem, bármi jó vagy rossz választ kell adnom. Nagyon közvetlen és tényleg biztonságos volt az egész. És szerintem ez egy külön erősség, hogy ennyire jelen tudsz lenni a másikkal, és meghallgatni, és várni. Azoknak ajánlanám, akik szeretnének mondjuk más szemszögből ránézni az adott problémáikra.”',
  },
  {
    name: 'Hermina',
    avatar: `${AVATAR_BASE_URL}/Hermina.webp`,
    quote:
      '„Én úgy éreztem, hogy nekem sikerült ellazulnom és felszabadultam. A legnagyobb felismerés számomra az volt, hogy mekkora hatalommal tud bírni egy mese, és hogy ez milyen pozitív hatásokkal tud lenni ránk. Szerintem nagyon jól vezetted fel az egészet, és a relaxációs résznél pedig különösen megnyugtató. És én bárkinek jó szívvel ajánlom, aki nyitott rá, és van benne bármifajta érdeklődés e felé, illetve önismeretnek sem utolsó.”',
  },
  {
    name: 'Zsaklin',
    quote:
      '„Nekem nagyon sokat adott a Lili mesefoglalkozása. Nem is hittem volna, hogy a mese és a rajzolás ennyi mindent ki tud hozni az emberből. Nagyon-nagyon segítség volt Lili nekem a kérdései, mert én az elején nem nagyon tudtam beszélni a rajzomról, de a kérdései sokat segítettek és nagyon sok mindent mélyről felhoztak belőlem, kihoztak belőlem, úgyhogy én csak ajánlani tudom a Lilit. Hatalmas köszönet neki.”',
  },
  {
    name: 'Ági',
    avatar:
      'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/socialproof/A%CC%81gi.webp',
    quote:
      '„Nekem fantasztikus élmény volt. Nagyon jó volt kiszakadni a hétköznapi teendőkből, és újra visszacsöppenni a mesék világába. Nagyon jó meseválasztás volt, nagyon tetszett, és olyan dolgokat hozott fel, amire egyáltalán nem gondoltam volna, hogy följöhet ilyen gondolati szinten. Rengeteg felismerésem volt a mese hallgatán. Mai modern világban muszáj picit lelassulnunk, és a mesék nagyon sokat tudnak segíteni nekünk ebben.”',
  },
  {
    name: 'Judit',
    avatar: `${AVATAR_BASE_URL}/Judit.webp`,
    quote:
      '„Szerintem nem sok olyan ember van, akinek nincs szüksége ítélkezésmentes közegre. Viszont minél inkább biztonságos teret adok, biztonságos emberekkel lehetek, annál könnyebb előrelépnem dolgokban mások tapasztalásaiból is, a megteremtett biztos térből. Nagyon-nagyon jó élmény volt a megteremtett közeg, és ennek a lehetőségével átgondolni dolgokat. Először nagyon biztonságos és könnyű dolog online ismerkedni az ilyen jellegű foglalkozásokkal, mert az a biztos tér, amit megteremtesz, még biztosabb azáltal, hogy úgymond te a saját fizikai téredben vagy.”',
  },
  {
    name: 'Anikó',
    avatar:
      'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/socialproof/Aniko%CC%81.webp',
    quote:
      '„A mesében aztán teljesen fel tudtam oldódni, és átadtam magam a folyamatnak. És a hozzáállásod, az elfogadásod az tényleg segített abban, hogy utána aztán igazából amilyen szinten ráláttam, azt tudtam mondani, tehát nem volt tabu. Ez pedig engem is meglepett, mert nem gondoltam magamra, hogy ilyen könnyen tudok beszélni a belső világomról. A legnagyobb felismerés számomra az volt, hogy megtaláltam a mesében azt az erőforrást, amit örömmel viszek tovább. Köszönöm ezt a támogató közeget neked.”',
  },
  {
    name: 'Heni',
    avatar: `${AVATAR_BASE_URL}/Heni.webp`,
    quote:
      '„Nagyon jól éreztem magam, abszolút el tudtam vonatkoztatni minden külső tényezőtől. És az egész alkalom alatt azt éreztem, hogy biztonságban vagyok, és hogy a témámról bármit mondhatok, azt megérted, és elfogadod. A legnagyobb felismerésem az volt, hogy bátrabbnak kell lennem, és hogy az álmaimért azért küzdjek tovább. Én mindenkinek ajánlanám, aki önismerettel foglalkozik, mert szerintem ez a mesézés ez egy tök jó része az önismereti utunknak.”',
  },
];
---

<section
  id="velemenyek"
  class="section bg-sage font-body font-light text-slate"
  aria-label="Vélemények"
>
  <div
    class="mx-auto flex max-w-content flex-col gap-[clamp(40px,5vw,72px)]"
  >
    <h2
      class="m-0 mx-auto max-w-[34ch] text-center font-display text-[clamp(26px,2.9vw,40px)] leading-[1.16] font-normal text-pretty"
    >
      Ők már megtapasztalták a csoportos mesefoglalkozások erejét.
    </h2>

    <div class="grid gap-[clamp(24px,3vw,40px)] sm:grid-cols-2">
      {
        videoTestimonials.map((item) => (
          <div class="flex flex-col gap-5 rounded-[24px] bg-cream p-[clamp(20px,2.4vw,28px)] text-slate shadow-[0_20px_45px_-15px_rgba(80,86,94,0.35)] sm:flex-row sm:items-start">
            <div
              class="relative aspect-4/5 w-full flex-none overflow-hidden rounded-[20px] bg-slate sm:w-[42%]"
              data-video-card
            >
              <video
                class="absolute inset-0 h-full w-full object-cover"
                preload="none"
                playsinline
                poster={item.poster}
              >
                <source src={item.videoSrc} type="video/mp4" />
              </video>

              <button
                type="button"
                data-play-trigger
                aria-label="Videó lejátszása"
                class="absolute inset-0 flex cursor-pointer items-center justify-center border-0 bg-slate/25 transition-opacity duration-100 hover:opacity-90"
              >
                <span class="flex h-14 w-14 items-center justify-center rounded-full bg-slate/80">
                  <svg
                    width="20"
                    height="22"
                    viewBox="0 0 20 22"
                    fill="var(--color-cream)"
                    aria-hidden="true"
                    class="ml-[3px]"
                  >
                    <path d="M0 0 20 11 0 22Z" />
                  </svg>
                </span>
              </button>
            </div>

            <div class="flex flex-1 flex-col gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-apricot">
                <svg
                  width="18"
                  height="14"
                  viewBox="0 0 18 14"
                  fill="var(--color-ink)"
                  aria-hidden="true"
                >
                  <path d="M0 14V8.4C0 3.36 2.88.72 7.2 0l.9 1.98c-2.34.72-3.6 2.16-3.78 4.32H7.2V14H0Zm10.08 0V8.4c0-5.04 2.88-7.68 7.2-8.4l.9 1.98c-2.34.72-3.6 2.16-3.78 4.32h3.78V14h-7.1Z" />
                </svg>
              </span>

              <p class="m-0 text-[clamp(16px,1.2vw,19px)] leading-[1.5] text-pretty">
                „{item.quote}”
              </p>

              <strong class="text-[15px] leading-[1.4]">{item.name}</strong>

              <span class="mt-1 flex w-fit items-center gap-[6px] rounded-pill bg-sage/30 px-[10px] py-[5px] text-[12px] font-semibold text-slate">
                <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="10" cy="10" r="8.5" />
                  <path d="m6.2 10.2 2.6 2.6 5-5.2" />
                </svg>
                Typeform verified
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <div class="columns-1 gap-[clamp(18px,2.2vw,28px)] sm:columns-2 lg:columns-3">
      {
        textTestimonials.map((item, index) => (
          <div class="mb-[clamp(18px,2.2vw,28px)] flex break-inside-avoid flex-col gap-3 rounded-[18px] border border-hairline-soft bg-cream p-[clamp(18px,2vw,24px)]">
            <div class="flex items-center gap-3">
              {item.avatar ? (
                <img
                  src={item.avatar}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                  class="h-10 w-10 flex-none rounded-full object-cover"
                />
              ) : (
                <span
                  class:list={[
                    'flex h-10 w-10 flex-none items-center justify-center rounded-full text-[14px] font-semibold text-ink',
                    avatarFills[index % avatarFills.length],
                  ]}
                  aria-hidden="true"
                >
                  {item.name.charAt(0)}
                </span>
              )}
              <strong class="text-[15px] leading-[1.3]">{item.name}</strong>
            </div>

            <div class="flex gap-[3px] text-apricot" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M10 1.5 12.6 7.3 19 8 14.2 12.2 15.5 18.5 10 15.2 4.5 18.5 5.8 12.2 1 8 7.4 7.3Z" />
                </svg>
              ))}
            </div>

            <p class="m-0 text-[14.5px] leading-[1.6] tracking-[0.16px] text-pretty">
              {item.quote}
            </p>

            <span class="mt-1 flex w-fit items-center gap-[6px] rounded-pill bg-sage/30 px-[10px] py-[5px] text-[12px] font-semibold text-slate">
              <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="10" cy="10" r="8.5" />
                <path d="m6.2 10.2 2.6 2.6 5-5.2" />
              </svg>
              Typeform verified
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Poster-less by design (see comment above): revealing native controls and
  // starting playback on click is enough until real footage + posters land.
  document.querySelectorAll<HTMLElement>('[data-video-card]').forEach((card) => {
    const video = card.querySelector('video');
    const trigger = card.querySelector('[data-play-trigger]');
    if (!(video instanceof HTMLVideoElement) || !trigger) return;

    trigger.addEventListener('click', () => {
      video.controls = true;
      video.play();
      trigger.remove();
    });
  });
</script>
