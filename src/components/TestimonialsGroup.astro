---
/*
  "Wall of love" — two video testimonials plus a masonry wall of short text
  reviews underneath, all in one section.

  Video files live in S3 and are not final yet, so `videoSrc` below are
  placeholder URLs (swap for the real `https://<bucket>.s3.amazonaws.com/...`
  links once uploaded). No poster image exists yet either, so each card shows
  a sage → slate gradient behind the <video> until it has a real poster/first
  frame — once real footage is wired up this reads as the video's own
  thumbnail.

  Every name, role, quote and date below — video and text alike — is
  explicit placeholder copy. Replace all of it with real participant
  feedback before this goes live: never ship an invented quote as if a real
  participant said it.
*/
const videoTestimonials = [
  {
    name: 'Placeholder név',
    role: 'Placeholder leírás',
    quote:
      'Ide kerül majd egy résztvevő saját szavaival elmondott élménye a csoportos mesefoglalkozásról.',
    videoSrc:
      'https://REPLACE-WITH-BUCKET.s3.amazonaws.com/testimonials/placeholder-1.mp4',
  },
  {
    name: 'Placeholder név',
    role: 'Placeholder leírás',
    quote:
      'Ide kerül majd egy másik résztvevő saját szavaival elmondott élménye a csoportos mesefoglalkozásról.',
    videoSrc:
      'https://REPLACE-WITH-BUCKET.s3.amazonaws.com/testimonials/placeholder-2.mp4',
  },
];

const avatarFills = ['bg-apricot', 'bg-sage', 'bg-terracotta/70'] as const;

const textTestimonials = [
  {
    name: 'Placeholder résztvevő 1',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote:
      'Placeholder szöveg: ide kerül majd egy résztvevő rövid, valódi visszajelzése a foglalkozásról.',
  },
  {
    name: 'Placeholder résztvevő 2',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote:
      'Placeholder szöveg: ide kerül majd egy hosszabb, valódi vélemény arról, hogyan élte meg a résztvevő a mesefoglalkozást, mit érzett közben, és mit vitt magával utána.',
  },
  {
    name: 'Placeholder résztvevő 3',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote: 'Placeholder szöveg: rövid, ütős valódi idézet kerül majd ide.',
  },
  {
    name: 'Placeholder résztvevő 4',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote:
      'Placeholder szöveg: ide kerül majd egy valódi vélemény arról, mennyire érezte biztonságosnak a teret a résztvevő.',
  },
  {
    name: 'Placeholder résztvevő 5',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote:
      'Placeholder szöveg: ide kerül majd egy valódi visszajelzés a foglalkozás hangulatáról és Liliről.',
  },
  {
    name: 'Placeholder résztvevő 6',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote:
      'Placeholder szöveg: ide kerül majd egy valódi vélemény, amely részletesen leírja, mi változott a résztvevő számára a foglalkozás óta, és miért ajánlaná másoknak is.',
  },
  {
    name: 'Placeholder résztvevő 7',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote: 'Placeholder szöveg: rövid, valódi idézet kerül majd ide.',
  },
  {
    name: 'Placeholder résztvevő 8',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote:
      'Placeholder szöveg: ide kerül majd egy valódi vélemény arról, hogyan segített a mesefoglalkozás ellazulni és feltöltődni.',
  },
  {
    name: 'Placeholder résztvevő 9',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote:
      'Placeholder szöveg: ide kerül majd egy valódi vélemény, amely kitér arra is, miért döntött úgy a résztvevő, hogy kipróbálja a foglalkozást.',
  },
  {
    name: 'Placeholder résztvevő 10',
    role: 'Placeholder leírás',
    date: 'Placeholder dátum',
    quote:
      'Placeholder szöveg: ide kerül majd egy rövid, valódi zárszó egy elégedett résztvevőtől.',
  },
];
---

<section
  id="velemenyek"
  class="section bg-sage font-body font-light text-slate"
  aria-label="Vélemények"
>
  <div
    class="mx-auto flex max-w-content flex-col gap-[clamp(40px,5vw,72px)]"
  >
    <h2
      class="m-0 mx-auto max-w-[34ch] text-center font-display text-[clamp(26px,2.9vw,40px)] leading-[1.16] font-normal text-pretty"
    >
      Ők már megtapasztalták a csoportos mesefoglalkozások erejét.
    </h2>

    <div class="grid gap-[clamp(24px,3vw,40px)] sm:grid-cols-2">
      {
        videoTestimonials.map((item) => (
          <div class="flex flex-col gap-5 rounded-[24px] bg-cream p-[clamp(20px,2.4vw,28px)] text-slate shadow-[0_20px_45px_-15px_rgba(80,86,94,0.35)] sm:flex-row sm:items-start">
            <div
              class="relative aspect-4/5 w-full flex-none overflow-hidden rounded-[20px] bg-gradient-to-br from-sage to-slate sm:w-[42%]"
              data-video-card
            >
              <video
                class="absolute inset-0 h-full w-full object-cover"
                preload="none"
                playsinline
              >
                <source src={item.videoSrc} type="video/mp4" />
              </video>

              <button
                type="button"
                data-play-trigger
                aria-label="Videó lejátszása"
                class="absolute inset-0 flex cursor-pointer items-center justify-center border-0 bg-slate/25 transition-opacity duration-100 hover:opacity-90"
              >
                <span class="flex h-14 w-14 items-center justify-center rounded-full bg-slate/80">
                  <svg
                    width="20"
                    height="22"
                    viewBox="0 0 20 22"
                    fill="var(--color-cream)"
                    aria-hidden="true"
                    class="ml-[3px]"
                  >
                    <path d="M0 0 20 11 0 22Z" />
                  </svg>
                </span>
              </button>
            </div>

            <div class="flex flex-1 flex-col gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-apricot">
                <svg
                  width="18"
                  height="14"
                  viewBox="0 0 18 14"
                  fill="var(--color-ink)"
                  aria-hidden="true"
                >
                  <path d="M0 14V8.4C0 3.36 2.88.72 7.2 0l.9 1.98c-2.34.72-3.6 2.16-3.78 4.32H7.2V14H0Zm10.08 0V8.4c0-5.04 2.88-7.68 7.2-8.4l.9 1.98c-2.34.72-3.6 2.16-3.78 4.32h3.78V14h-7.1Z" />
                </svg>
              </span>

              <p class="m-0 text-[clamp(16px,1.2vw,19px)] leading-[1.5] text-pretty">
                „{item.quote}”
              </p>

              <p class="m-0 text-[15px] leading-[1.4]">
                <strong>{item.name}</strong>
                <br />
                <span class="opacity-75">{item.role}</span>
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="columns-1 gap-[clamp(18px,2.2vw,28px)] sm:columns-2 lg:columns-3">
      {
        textTestimonials.map((item, index) => (
          <div class="mb-[clamp(18px,2.2vw,28px)] flex break-inside-avoid flex-col gap-3 rounded-[18px] border border-hairline-soft bg-cream p-[clamp(18px,2vw,24px)]">
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  'flex h-10 w-10 flex-none items-center justify-center rounded-full text-[14px] font-semibold text-ink',
                  avatarFills[index % avatarFills.length],
                ]}
                aria-hidden="true"
              >
                {item.name.at(-1)}
              </span>
              <div class="flex flex-col">
                <strong class="text-[15px] leading-[1.3]">{item.name}</strong>
                <span class="text-[13px] leading-[1.3] opacity-70">
                  {item.role}
                </span>
              </div>
            </div>

            <div class="flex gap-[3px] text-apricot" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M10 1.5 12.6 7.3 19 8 14.2 12.2 15.5 18.5 10 15.2 4.5 18.5 5.8 12.2 1 8 7.4 7.3Z" />
                </svg>
              ))}
            </div>

            <p class="m-0 text-[14.5px] leading-[1.6] tracking-[0.16px] text-pretty">
              {item.quote}
            </p>

            <span class="text-[13px] opacity-60">{item.date}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Poster-less by design (see comment above): revealing native controls and
  // starting playback on click is enough until real footage + posters land.
  document.querySelectorAll<HTMLElement>('[data-video-card]').forEach((card) => {
    const video = card.querySelector('video');
    const trigger = card.querySelector('[data-play-trigger]');
    if (!(video instanceof HTMLVideoElement) || !trigger) return;

    trigger.addEventListener('click', () => {
      video.controls = true;
      video.play();
      trigger.remove();
    });
  });
</script>
