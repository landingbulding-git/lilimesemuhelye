---
import MobileNav from './MobileNav';
import { EXTERNAL_LINK_ATTRS, NAV_CTA, NAV_LINKS } from '../data/site';

// NOTE: "Zseb-Menedék mesetár" points at the second page from the design export,
// which has not been built yet.
---

{/* `sticky` is a positioned element, so the mobile menu panel anchors to this bar. */}
<header
  class="sticky top-0 z-50 border-b border-hairline bg-cream font-body font-light text-slate"
>
  <div
    class="mx-auto flex max-w-canvas items-center justify-between gap-6 px-[4vw] py-[14px]"
  >
    <a
      href="#"
      class="font-display text-[clamp(18px,2vw,22px)] leading-[1.2] text-slate no-underline hover:text-slate"
    >
      Lili Meseműhelye
    </a>

    {/* Desktop bar: plain markup, no JS. Hidden below the md breakpoint, where
        MobileNav's hamburger takes over. */}
    <nav
      class="hidden items-center gap-x-[clamp(16px,2.4vw,34px)] md:flex"
      aria-label="Fő navigáció"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-[16px] whitespace-nowrap text-slate no-underline transition-opacity duration-100 hover:text-slate hover:opacity-70"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={NAV_CTA.href}
        {...EXTERNAL_LINK_ATTRS}
        class="btn-apricot px-[18px] py-[7px] text-[14px] font-semibold whitespace-nowrap"
      >
        {NAV_CTA.label}
      </a>
    </nav>

    {/* Wrapped so the island itself leaves the desktop flex row entirely — an
        empty flex item would still consume a `gap` and skew justify-between. */}
    <div class="md:hidden">
      <MobileNav client:media="(max-width: 767.98px)" />
    </div>
  </div>
</header>
