---
import { BOOKING_URL, EXTERNAL_LINK_ATTRS } from '../data/site';

// NOTE: "Zseb-Menedék mesetár" points at the second page from the design export,
// which has not been built yet.
---

<header
  class="sticky top-0 z-50 border-b border-hairline bg-cream font-body font-light text-slate"
>
  <div
    class="mx-auto flex max-w-canvas flex-wrap items-center justify-between gap-x-6 gap-y-3 px-[4vw] py-[14px]"
  >
    <a
      href="#"
      class="font-display text-[clamp(18px,2vw,22px)] leading-[1.2] text-slate no-underline hover:text-slate"
    >
      Lili Meseműhelye
    </a>

    <nav
      class="flex flex-wrap items-center gap-x-[clamp(16px,2.4vw,34px)] gap-y-3"
      aria-label="Fő navigáció"
    >
      <a
        href="#csomagok"
        class="text-[16px] whitespace-nowrap text-slate no-underline transition-opacity duration-100 hover:text-slate hover:opacity-70"
      >
        Csomagok
      </a>
      <a
        href="#"
        class="text-[16px] text-slate no-underline transition-opacity duration-100 hover:text-slate hover:opacity-70"
      >
        Zseb-Menedék mesetár
      </a>
      <a
        href={BOOKING_URL}
        {...EXTERNAL_LINK_ATTRS}
        class="btn-apricot px-[18px] py-[7px] text-[14px] font-semibold whitespace-nowrap"
      >
        Kipróbálom Díjmentesen!
      </a>
    </nav>
  </div>
</header>
