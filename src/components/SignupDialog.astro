---
/*
  Rendered once per page. Every `[data-signup-trigger]` button on the page opens it.
  Built on the native <dialog> element — see PurchaseDialog.astro for why.

  TODO: once the real Sequenzy account for Lili Meseműhelye is connected, submit
  firstName/email to it here instead of just forwarding to the Cal.com booking page.
*/
import { BOOKING_URL } from '../data/site';

const legalLinkClass =
  'text-slate underline underline-offset-2 hover:text-terracotta';

// The legal pages open in a new tab so an in-progress signup is not lost.
const legalLinkAttrs = { target: '_blank', rel: 'noopener' };
---

<dialog
  id="signup-dialog"
  aria-labelledby="signup-dialog-title"
  class="m-auto max-h-[85dvh] w-[min(92vw,480px)] overflow-y-auto bg-cream p-0 text-slate backdrop:bg-slate/60"
>
  <div
    class="relative flex flex-col gap-[clamp(16px,2.5vw,22px)] p-[clamp(24px,4.5vw,44px)] font-body text-[clamp(14px,1.05vw,16px)] leading-[1.6] font-light tracking-[0.16px]"
  >
    {/* method="dialog" closes the dialog natively, no script involved. */}
    <form method="dialog" class="absolute top-[10px] right-[10px] m-0">
      <button
        type="submit"
        aria-label="Bezárás"
        class="flex h-10 w-10 cursor-pointer items-center justify-center border-0 bg-transparent text-slate transition-opacity duration-100 hover:opacity-60"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </form>

    <p
      id="signup-dialog-title"
      class="m-0 max-w-[34ch] pr-10 font-display text-[clamp(19px,1.8vw,24px)] leading-[1.3] font-normal text-pretty"
    >
      Foglald le a helyed a díjmentes mesefoglalkozáson
    </p>

    <form id="signup-form" class="flex flex-col gap-[16px]" novalidate>
      <label class="flex flex-col gap-[6px]">
        <span class="text-[14px] font-semibold">Keresztnév</span>
        <input
          type="text"
          name="firstName"
          autocomplete="given-name"
          required
          class="border border-hairline bg-cream px-[14px] py-[11px] text-[15px] text-slate outline-none focus:border-terracotta"
        />
      </label>

      <label class="flex flex-col gap-[6px]">
        <span class="text-[14px] font-semibold">Email cím</span>
        <input
          type="email"
          name="email"
          autocomplete="email"
          required
          class="border border-hairline bg-cream px-[14px] py-[11px] text-[15px] text-slate outline-none focus:border-terracotta"
        />
      </label>

      <label class="flex items-start gap-[10px]">
        <input
          type="checkbox"
          name="consent"
          required
          class="mt-[3px] h-[16px] w-[16px] flex-none accent-terracotta"
        />
        <span class="text-[13px] leading-[1.55] opacity-85 text-pretty">
          Elolvastam, megértettem és elfogadom az
          <a href="/aszf" class={legalLinkClass} {...legalLinkAttrs}
            >Általános Szerződési Feltételeket</a
          >, az
          <a href="/adatvedelem" class={legalLinkClass} {...legalLinkAttrs}
            >Adatvédelmi Tájékoztatót</a
          >, valamint a
          <a href="/nyilatkozat" class={legalLinkClass} {...legalLinkAttrs}
            >Felelősségkizáró és Egészségügyi Nyilatkozatot</a
          >, és a bennük foglaltakat magamra nézve kötelező érvényűnek ismerem el.
        </span>
      </label>

      <button
        type="submit"
        class="btn-apricot mt-[6px] cursor-pointer px-[30px] py-[15px] text-[clamp(15px,1.1vw,17px)] font-semibold"
      >
        Szeretném kipróbálni a mesék ősi hatását díjmentesen
      </button>
    </form>
  </div>
</dialog>

<script define:vars={{ bookingUrl: BOOKING_URL }}>
  const dialog = document.getElementById('signup-dialog');
  const form = document.getElementById('signup-form');

  if (dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement) {
    const triggers = document.querySelectorAll('[data-signup-trigger]');

    for (const trigger of triggers) {
      trigger.addEventListener('click', () => {
        // showModal() makes the page inert but does not stop it scrolling.
        document.body.style.overflow = 'hidden';
        dialog.showModal();
      });
    }

    // Only the backdrop reports the dialog itself as the target — the content sits
    // in a padded child, so clicks inside it never match.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Fires for every close path: the button, Escape, and the backdrop.
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      // TODO: send firstName/email to Sequenzy once the real account is wired up.
      window.open(bookingUrl, '_blank', 'noopener,noreferrer');
      dialog.close();
      form.reset();
    });
  }
</script>
