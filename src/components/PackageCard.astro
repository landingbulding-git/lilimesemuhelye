---
interface Props {
  name: string;
  price: string;
  perSession: string;
  /** First bullet differs per package (3 / 6 / 12 months). */
  validity: string;
  /** Renders the "Legtöbben ezt választják" badge + emphasised frame. */
  featured?: boolean;
}

const { name, price, perSession, validity, featured = false } = Astro.props;

const features = [
  `Felhasználható <strong>${validity}</strong>`,
  'Prémium rajzeszközök postázása',
  'Korlátaln hozzáférés a „Belső munka” sablonokhoz',
  'Korlátlan „SOS Zseb-Menedék” mesetár hozzáférés',
  '24/7 hozzáférés a Menedék Csoporthoz',
  'A program végén megkapod a saját mesédet az utazásodról',
];
---

<div
  class:list={[
    'flex flex-col gap-6 self-stretch bg-cream px-[clamp(26px,2.6vw,36px)] text-slate',
    featured
      ? 'py-[clamp(32px,3.4vw,48px)] outline-[3px] -outline-offset-[3px] outline-slate'
      : 'py-[clamp(26px,2.8vw,38px)]',
  ]}
>
  {
    featured && (
      <span class="self-start rounded-pill bg-slate px-4 py-[7px] text-[13px] tracking-[0.32px] text-cream">
        Legtöbben ezt választják
      </span>
    )
  }

  <div class="flex flex-col gap-[10px]">
    <h3
      class="m-0 font-display text-[clamp(20px,1.85vw,26px)] leading-[1.24] font-normal text-pretty"
    >
      {name}
    </h3>
    <p class="m-0 font-display text-[clamp(28px,2.8vw,38px)] leading-[1.1]">
      <strong>{price}</strong>
    </p>
    <p class="m-0 text-[clamp(14px,1.05vw,16px)] leading-[1.5] opacity-80">
      {perSession}
    </p>
  </div>

  <ul
    class="m-0 flex list-none flex-col gap-[14px] p-0 text-[clamp(14px,1.05vw,16px)] leading-[1.5] text-slate"
  >
    {
      features.map((feature) => (
        <li class="flex items-start gap-3 border-b border-hairline-soft pb-[14px]">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="mt-[3px] flex-none"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
          <span set:html={feature} />
        </li>
      ))
    }
  </ul>

  <a
    href="#"
    class:list={[
      'mt-auto self-start px-[30px] py-[14px] text-[16px] font-extrabold',
      featured ? 'btn-apricot' : 'btn-outline',
    ]}
  >
    Ezt választom
  </a>
</div>
