---
// Decorative hand-drawn marks lifted from the main hero photo (sketchy play
// triangle, scribble knot, concentric apricot loops). Purely ornamental.
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  {/* Sketchy triangle — slate */}
  <svg
    viewBox="0 0 100 100"
    fill="none"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="absolute top-[10px] left-[4vw] h-[clamp(40px,6vw,92px)] w-[clamp(40px,6vw,92px)] -rotate-6 text-slate/80 md:top-[6%]"
  >
    <path d="M10 10 L92 52 L12 92 Z"></path>
    <path d="M15 9 Q52 28 91 50 Q52 72 14 91"></path>
    <path d="M9 14 L88 54"></path>
  </svg>

  {/* Scribble knot — sage */}
  <svg
    viewBox="0 0 100 100"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    class="absolute top-[10px] right-[4vw] h-[clamp(44px,7vw,104px)] w-[clamp(44px,7vw,104px)] text-sage md:top-[4%]"
  >
    <ellipse cx="50" cy="50" rx="44" ry="26" transform="rotate(0 50 50)"></ellipse>
    <ellipse cx="52" cy="48" rx="40" ry="30" transform="rotate(28 50 50)"></ellipse>
    <ellipse cx="48" cy="52" rx="43" ry="22" transform="rotate(58 50 50)"></ellipse>
    <ellipse cx="51" cy="50" rx="36" ry="32" transform="rotate(88 50 50)"></ellipse>
    <ellipse cx="49" cy="51" rx="42" ry="28" transform="rotate(118 50 50)"></ellipse>
    <ellipse cx="50" cy="49" rx="38" ry="24" transform="rotate(148 50 50)"></ellipse>
  </svg>

  {/* Concentric apricot loops — large, cropped by the section edge, desktop only */}
  <svg
    viewBox="0 0 220 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    class="absolute bottom-[8%] -left-[60px] hidden w-[260px] -rotate-12 text-apricot lg:block"
  >
    <g transform="translate(110 60)">
      <path d="M-80 0C-80-30-30-42 0-26C30-42 80-30 80 0C80 30 30 42 0 26C-30 42-80 30-80 0Z"></path>
      <path d="M-80 0C-80-30-30-42 0-26C30-42 80-30 80 0C80 30 30 42 0 26C-30 42-80 30-80 0Z" transform="scale(0.78)"></path>
      <path d="M-80 0C-80-30-30-42 0-26C30-42 80-30 80 0C80 30 30 42 0 26C-30 42-80 30-80 0Z" transform="scale(0.56)"></path>
    </g>
  </svg>
  <svg
    viewBox="0 0 220 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    class="absolute top-[38%] -right-[70px] hidden w-[280px] rotate-12 text-apricot lg:block"
  >
    <g transform="translate(110 60)">
      <path d="M-80 0C-80-30-30-42 0-26C30-42 80-30 80 0C80 30 30 42 0 26C-30 42-80 30-80 0Z"></path>
      <path d="M-80 0C-80-30-30-42 0-26C30-42 80-30 80 0C80 30 30 42 0 26C-30 42-80 30-80 0Z" transform="scale(0.78)"></path>
      <path d="M-80 0C-80-30-30-42 0-26C30-42 80-30 80 0C80 30 30 42 0 26C-30 42-80 30-80 0Z" transform="scale(0.56)"></path>
    </g>
  </svg>
  {/* Second batch: smaller companions, desktop/tablet only so phones stay calm */}
  <svg
    viewBox="0 0 100 100"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    class="absolute bottom-[28%] left-[3vw] hidden h-[clamp(48px,5vw,72px)] w-[clamp(48px,5vw,72px)] text-sage md:block"
  >
    <ellipse cx="50" cy="50" rx="44" ry="24" transform="rotate(12 50 50)"></ellipse>
    <ellipse cx="52" cy="49" rx="40" ry="28" transform="rotate(48 50 50)"></ellipse>
    <ellipse cx="49" cy="51" rx="42" ry="22" transform="rotate(84 50 50)"></ellipse>
    <ellipse cx="50" cy="50" rx="36" ry="30" transform="rotate(122 50 50)"></ellipse>
    <ellipse cx="51" cy="50" rx="40" ry="25" transform="rotate(156 50 50)"></ellipse>
  </svg>

  <svg
    viewBox="0 0 100 100"
    fill="none"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="absolute right-[5vw] bottom-[5%] hidden h-[clamp(44px,4.5vw,68px)] w-[clamp(44px,4.5vw,68px)] rotate-[24deg] text-slate/80 md:block"
  >
    <path d="M10 10 L92 52 L12 92 Z"></path>
    <path d="M15 9 Q52 28 91 50 Q52 72 14 91"></path>
  </svg>

  <svg
    viewBox="0 0 220 120"
    fill="none"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linecap="round"
    class="absolute top-[24%] left-[2vw] hidden w-[130px] rotate-[8deg] text-apricot lg:block"
  >
    <g transform="translate(110 60)">
      <path d="M-80 0C-80-30-30-42 0-26C30-42 80-30 80 0C80 30 30 42 0 26C-30 42-80 30-80 0Z"></path>
      <path d="M-80 0C-80-30-30-42 0-26C30-42 80-30 80 0C80 30 30 42 0 26C-30 42-80 30-80 0Z" transform="scale(0.7)"></path>
    </g>
  </svg>
</div>
