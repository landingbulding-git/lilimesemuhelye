<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lili Meseműhelye - Ajándékozz énidőt!</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['Lora', 'serif'],
                        sans: ['Nunito', 'sans-serif'],
                    },
                    colors: {
                        mese: {
                            light: '#fdfbf7', // Meleg törtfehér
                            rose: '#e5a8a1',  // Finom fáradtrózsaszín
                            dark: '#5c4340',  // Meleg barna a szöveghez
                            accent: '#d48a81'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Egyedi háttér a mesés hangulathoz */
        body {
            background: linear-gradient(135deg, #fdfbf7 0%, #faeee9 50%, #f4dedb 100%);
            min-height: 100vh;
        }
        /* Finom lebegő animáció a kártyához */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-5px); }
            100% { transform: translateY(0px); }
        }
        .floating-card {
            animation: float 6s ease-in-out infinite;
        }
    </style>
</head>

<body class="flex flex-col items-center justify-center p-4 sm:p-6 text-mese-dark antialiased">

    <!-- Fő tartalom konténer -->
    <div class="floating-card max-w-md w-full bg-white/80 backdrop-blur-md p-8 sm:p-10 rounded-[2rem] shadow-xl border border-white/50 relative overflow-hidden">
        
        <!-- Díszítő elem (halvány levélminta jellegű forma a sarokban) -->
        <div class="absolute -top-10 -right-10 w-32 h-32 bg-mese-rose opacity-20 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-amber-200 opacity-20 rounded-full blur-2xl pointer-events-none"></div>

        <!-- Fejléc és ikon -->
        <div class="text-center mb-6 relative z-10">
            <div class="w-20 h-20 bg-mese-light border-2 border-mese-rose rounded-full flex items-center justify-center mx-auto mb-5 shadow-sm">
                <!-- Szív / Ajándék ikon -->
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-mese-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 11.5v.01" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 11.5v.01" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11.5v.01" />
                </svg>
            </div>
            <h1 class="font-serif text-3xl font-semibold mb-3 text-gray-800">Ajándékozz énidőt!</h1>
            <p class="font-sans text-gray-600 leading-relaxed text-sm sm:text-base">
                Gondolj egy nőre a környezetedben, aki mindig másokról gondoskodik. Hívd meg, hogy ő is megtapasztalhassa ezt a biztonságos, töltekező teret.
            </p>
        </div>

        <div class="relative z-10 mt-8">
            <button id="shareButton" class="w-full group bg-gradient-to-r from-mese-accent to-[#c97970] hover:from-[#c97970] hover:to-[#b8675f] text-white font-sans font-bold text-lg py-4 px-6 rounded-2xl shadow-lg shadow-mese-rose/50 active:scale-95 transition-all duration-300 flex items-center justify-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:-translate-y-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                </svg>
                Megosztás / Küldés
            </button>
            
            <!-- Visszajelző üzenet helye -->
            <div id="feedbackMessage" class="hidden mt-4 text-center font-sans text-sm text-green-600 bg-green-50 py-2 px-4 rounded-xl border border-green-100 transition-opacity duration-300 opacity-0">
                Köszönjük, hogy megosztod! 🌸
            </div>
        </div>
        
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const shareButton = document.getElementById('shareButton');
            const feedbackMessage = document.getElementById('feedbackMessage');
            
            // A megosztandó adatok
            const shareData = {
                title: 'Lili Meseműhelye',
                text: 'Szia! Arra gondoltam, ez az ingyenes mesefoglalkozás igazi töltekezés lehetne neked is!',
                url: 'https://www.lilimesemuhelye.hu/ingyenes-csoportfoglalkozas'
            };

            shareButton.addEventListener('click', async () => {
                // Ellenőrizzük, hogy az eszköz támogatja-e a modern megosztást (mobilon szinte 100%)
                if (navigator.share) {
                    try {
                        // Megnyitja a telefon saját megosztó paneljét (Messenger, WhatsApp, stb.)
                        await navigator.share(shareData);
                        
                        // Sikeres megosztás utáni kedves vizuális visszajelzés (alert helyett)
                        feedbackMessage.classList.remove('hidden');
                        setTimeout(() => {
                            feedbackMessage.classList.remove('opacity-0');
                        }, 10);
                        
                        // 4 másodperc múlva eltüntetjük
                        setTimeout(() => {
                            feedbackMessage.classList.add('opacity-0');
                            setTimeout(() => feedbackMessage.classList.add('hidden'), 300);
                        }, 4000);

                    } catch (error) {
                        // Ha a felhasználó rákattintott, de utána bezárta a panelt anélkül, 
                        // hogy küldött volna, a rendszer hibát dob, de ezt elég csak logolni.
                        console.log('Megosztás megszakítva.', error);
                    }
                } else {
                    // FALLBACK: Ha asztali gépen van valaki, vagy nagyon régi böngészőből nyitja meg,
                    // biztonsági hálóként megnyitjuk a Facebook megosztót.
                    const fallbackUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(shareData.url);
                    window.open(fallbackUrl, '_blank', 'width=600,height=400');
                }
            });
        });
    </script>
</body>
</html>