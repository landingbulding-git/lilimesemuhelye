---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroGroup from '../components/HeroGroupFree.astro';
import TestimonialsGroup from '../components/TestimonialsGroup.astro';
import SectionDivider from '../components/SectionDivider.astro';
import Struggle from '../components/Struggle.astro';
import ValueProps from '../components/ValueProps.astro';
import ProcessGroup from '../components/ProcessGroup.astro';
import Guarantees from '../components/Guarantees.astro';
import Founder from '../components/Founder.astro';
import Faq from '../components/Faq.astro';
import FinalCtaGroup from '../components/FinalCtaGroupFree.astro';
import Footer from '../components/Footer.astro';

const title = 'Lili Meseműhelye — Exkluzív csoportos mesefoglalkozás';
const description =
  'Biztonságos, ítélkezésmentes online tér, ahol a mesék ősi szimbólumai segítenek feloldani az elakadásaidat. Csak 5 hely maradt a következő alkalomra.';

const navCta = {
  label: 'Kipróbálom a mesék ősi hatását',
  href: 'https://luma.com/event/evt-QCOFb7AANayilvW',
};
---

<BaseLayout title={title} description={description}>
  <Header navLinks={[]} navCta={navCta} />
  <main>
    <HeroGroup />
    <TestimonialsGroup />
    <SectionDivider />
    <Struggle />
    <ValueProps />
    <ProcessGroup />
    <Guarantees />
    <Founder />
    <Faq />
    <FinalCtaGroup />
  </main>
  <Footer />
</BaseLayout>

<script define:vars={{ lumaEventUrl: navCta.href }}>
  // Every CTA on this page (hero, closer, navbar) links to the same Luma
  // event, so one click listener covers all of them. On click, fires a
  // browser Pixel "Purchase" and a server-side Conversions API "Purchase"
  // with the same event_id, so Meta deduplicates them into a single event.
  function readCookie(name) {
    const match = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`));
    return match ? decodeURIComponent(match[1]) : undefined;
  }

  const ctaLinks = document.querySelectorAll(`a[href^="${lumaEventUrl}"]`);

  ctaLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const eventId = crypto.randomUUID();
      const eventSourceUrl = window.location.href;
      const value = 0;
      const currency = 'HUF';

      if (typeof fbq === 'function') {
        fbq('track', 'Purchase', { value, currency }, { eventID: eventId });
      }

      fetch('/api/track-purchase', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({
          eventId,
          eventSourceUrl,
          value,
          currency,
          userAgent: navigator.userAgent,
          fbp: readCookie('_fbp'),
          fbc: readCookie('_fbc'),
        }),
      }).catch(() => {});
    });
  });
</script>
