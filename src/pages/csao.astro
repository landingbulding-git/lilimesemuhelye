---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';

const title = 'Lili Meseműhelye — Ingyenes mesefoglalkozás anyaotthonokban';
const description =
  'Ingyenes mesefoglalkozás anyaotthonokban élő felnőtt nőknek.';

const BLOB = 'https://dtc0hpasupe3ji2k.public.blob.vercel-storage.com/csao';
const video = { src: `${BLOB}/testvideo.mp4`, poster: `${BLOB}/testvideo_poster.jpg` };

const questions = [
  'Mi az a mesefoglalkozás?',
  'Ki vagyok én?',
  'Mi a koncepció az anyaotthonok számára?',
  'Mennyibe kerül ez nekünk?',
];

const videoClass =
  'block aspect-video w-full rounded-[20px] bg-slate/10 object-cover shadow-[0_20px_45px_-15px_rgba(80,86,94,0.35)]';
---

<BaseLayout title={title} description={description}>
  <main class="font-body font-light text-slate">
    <section class="bg-cream px-[4vw] py-[clamp(32px,9vw,56px)]" aria-label="Bemutatkozás">
      <div class="mx-auto flex w-full max-w-[900px] flex-col items-center gap-[clamp(24px,3.5vw,40px)] text-center">
        <h1
          class="m-0 max-w-[30ch] font-display text-[clamp(26px,2.9vw,40px)] leading-[1.18] font-normal tracking-[-0.01em] text-pretty"
        >
          Ingyenes mesefoglalkozás anyaotthonokban élő felnőtt nőknek
        </h1>
        <video
          class={videoClass}
          src={video.src}
          poster={video.poster}
          controls
          playsinline
          preload="metadata"></video>
      </div>
    </section>

    <section id="gyik" class="section bg-cream" aria-label="GYIK">
      <div class="mx-auto flex max-w-[900px] flex-col gap-[clamp(28px,3.5vw,48px)]">
        <h2
          class="m-0 mx-auto max-w-[40ch] text-center font-display text-[clamp(26px,2.9vw,40px)] leading-[1.16] font-normal text-pretty"
        >
          Mit szeretnél tudni a foglalkozásról?
        </h2>

        {/* Native <details>: no JS island needed, and the video markup stays out
            of the way until opened (preload="none" so closed videos cost nothing). */}
        <div class="flex flex-col border-t border-hairline">
          {
            questions.map((q) => (
              <details class="faq group border-b border-hairline">
                <summary class="flex w-full cursor-pointer list-none items-baseline justify-between gap-6 py-[22px] text-left font-display text-[clamp(17px,1.5vw,22px)] leading-[1.3] font-normal transition-opacity duration-100 hover:opacity-70 [&::-webkit-details-marker]:hidden">
                  <span class="text-pretty">{q}</span>
                  <span aria-hidden="true" class="flex-none text-[20px] leading-none">
                    <span class="group-open:hidden">+</span>
                    <span class="hidden group-open:inline">–</span>
                  </span>
                </summary>
                <div class="pb-[26px]">
                  <video
                    class={videoClass}
                    src={video.src}
                    poster={video.poster}
                    controls
                    playsinline
                    preload="none"
                  />
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
